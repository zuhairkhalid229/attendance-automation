# Copy this to .env and fill in. Never commit the real .env.
ATT_EMAIL=you@example.com
ATT_PASSWORD=change-me-after-you-rotate-it

# Timing is controlled by the GitHub Actions cron (see the workflow). On top of
# the scheduled time the script waits a random amount, up to SPREAD_MINUTES, so
# the exact minute varies day to day. Bounded -> never a long/stuck sleep.
SPREAD_MINUTES=20

# Your profile lists all 7 days as working days, so default is false.
SKIP_WEEKENDS=false

# What the "what was done" field says.
REPORT_TEXT=dinenova

# Or auto-draft it from a repo's commits that day:
REPORT_FROM_GIT=false
GIT_REPO=e:/VSCODE/Restaurant Management System
